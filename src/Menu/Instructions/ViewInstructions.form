<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="Menu.Instructions.ViewInstructions">
  <grid id="27dc6" binding="mainPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <scrollpane id="acc29">
        <constraints border-constraint="Center"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="cb07f" class="javax.swing.JTextPane" binding="txtpInstructions" custom-create="true">
            <constraints/>
            <properties>
              <editable value="false"/>
            </properties>
          </component>
        </children>
      </scrollpane>
      <grid id="ccd08" layout-manager="GridBagLayout">
        <constraints border-constraint="East"/>
        <properties/>
        <border type="none"/>
        <children/>
      </grid>
      <toolbar id="e11d4">
        <constraints border-constraint="North"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="77383" class="javax.swing.JButton" binding="btnTablasInstruc">
            <constraints/>
            <properties>
              <text value="Tablas"/>
            </properties>
          </component>
          <component id="2f195" class="javax.swing.JButton" binding="btnExcelInstruc">
            <constraints/>
            <properties>
              <text value="Archivo Excel"/>
            </properties>
          </component>
        </children>
      </toolbar>
    </children>
  </grid>
</form>
